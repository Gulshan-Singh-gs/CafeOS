# CafeOS Environment Configuration

# --- SUPABASE POSTGRESQL & AUTH (OPTIONAL) ---
# When provided, CafeOS connects directly to your live Supabase cloud database.
# When left unset, CafeOS uses the built-in local persistent relational engine with full tenant isolation and seed data.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # Server-only, NEVER exposed to client browser

# --- APPLICATION SETTINGS ---
PORT=3000
NODE_ENV="development"

